  "devDependencies": {
    "playwright": "^1.48.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "better-auth": "^1.7.25",
    "fast-xml-parser": "^5.12.1",
    "undici": "^7.30.2",
    "wechat-crypto": "^0.0.2"
  }
}
