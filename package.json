{
  "name": "posewear",
  "private": true,
  "description": "衣姿 PoseWear：姿势、服装、人像参考图库与 AI 试穿工作台",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "node server/local.mjs",
    "serve": "node server/local.mjs",
